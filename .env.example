# Production environment variables for StarBrandStudio (Coolify → app → Environment
# Variables). Copy this file to .env.local for local dev and fill in real values.
# Never commit a filled-in copy — .env and .env.local are gitignored.

# --- Core (required) ---------------------------------------------------------
# Postgres (Neon in production).
DATABASE_URI=
# Long random string; rotating it invalidates all admin sessions.
PAYLOAD_SECRET=

# --- Email: Amazon SES (required in production) ------------------------------
# SES authenticates every connection — unlike the old Google Workspace relay,
# which allowlisted the server by IP and needed no credentials here. Without
# SMTP_USER/SMTP_PASS the app still boots but every form email fails with a 530.
#
# SMTP_USER/SMTP_PASS are SES *SMTP* credentials (IAM → SES SMTP settings →
# "Create SMTP credentials"), NOT a raw IAM access key + secret key.
SMTP_USER=
SMTP_PASS=
# The remaining SES settings have working defaults in payload.config.ts and only
# need setting to override them:
#   SMTP_HOST      — default email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT      — default 587 (STARTTLS); 465/2465 implicit TLS, 25 is throttled
#   EMAIL_FROM     — default smgbrandstudio@thestar.com.my; must be a verified SES
#                    identity in the same region as SMTP_HOST
#   SMTP_EHLO_NAME — default thestar.com.my
#
# Set to true to skip SMTP entirely and log emails to the console instead. This is
# for local dev only — never set it in production.
#SMTP_DISABLED=true

# --- Optional ----------------------------------------------------------------
# Google Analytics 4 measurement ID; analytics is simply omitted when unset.
#NEXT_PUBLIC_GA_ID=
# Google Tag Manager container ID. Defaults to the production container
# (GTM-MNFVNRFT); set this only to point a non-production deploy at another one.
#NEXT_PUBLIC_GTM_ID=
# Canonical public origin, no trailing slash. Feeds metadataBase, the canonical
# link, og:url and the WebSite structured data Google reads the search-result site
# name from. Defaults to https://smgbrandstudio.my; only set this to override
# (e.g. a staging hostname that should not advertise the production URL).
#NEXT_PUBLIC_SITE_URL=
# Vercel Blob storage. Unset on the self-hosted deploy — media falls back to
# ./media, which is baked into the image (see Dockerfile).
#BLOB_READ_WRITE_TOKEN=
